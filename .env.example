# Copier ce fichier en ".env" et renseigner votre token
# Le .mcp.json lit la variable GITHUB_PAT depuis l'environnement du shell
# (à exporter avant de lancer votre assistant de code, voir README.md)

GITHUB_PAT=ghp_votre_token_ici

