{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}"
      }
    },
    "hackathon": {
      "type": "stdio",
      "command": "bun",
      "args": ["run", "mcp-server/src/index.ts"],
      "env": {
        "GITHUB_PAT": "${GITHUB_PAT:-}"
      }
    }
  }
}
