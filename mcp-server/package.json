{
  "name": "hackathon-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Serveur MCP maison — TypeScript + bun",
  "scripts": {
    "start": "bun run src/index.ts",
    "http": "bun --watch src/http.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run scripts/smoke.ts",
    "inspect": "bunx @modelcontextprotocol/inspector bun run src/index.ts",
    "check": "bun run typecheck && bun test && bun run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
